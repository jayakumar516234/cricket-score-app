# Copy this file to .env and edit the values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cricket_app
# Used only by `npm test` (the test database is wiped on every run!)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/cricket_app_test
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Seed script (npm run seed). Development defaults only.
# In production the seed script REFUSES to run unless a strong password (10+ chars) is given here.
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@gmail.com
SEED_SUPERADMIN_PASSWORD=1
